          "main_language": "lzh",
          "columns": [
            {
              "text": "今夫天下之扁盧妙手因病"
            },
            {
              "text": "施藥輒奏奇功而於目疾獨"
            },
            {
              "text": "少治法即市上偶有專醫眼"
            },
            {
              "text": "科者亦祗能治未瞽之目而"
            },
            {
              "text": "不能治已瞽之目也乃福州"
            },
            {
              "text": "時昇里塔亭街地方有濟世"
            },
            {
              "text": "醫館其中西醫二人皆有國"
            },
            {
              "text": "手之目凡疑難之症醫治獲"
            },
            {
              "text": "痊者姑勿賸論□奇者有鄉"
            },
            {
              "text": "人王玉山素業手藝雙目失"
            },
            {
              "text": "明業已九年一日至該館求"
            },
            {
              "text": "治適西醫亞丹先生為之診"
            },
            {
              "text": "視曰目珠似雉子一重又一"
            },
            {
              "text": "重共三十二重今子目有翳"
            },
            {
              "text": "在第四重宜用刀割之藥水"
            }
          ],
          "extras": [
            {
