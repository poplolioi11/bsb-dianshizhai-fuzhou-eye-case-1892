        {
          "side": "left",
          "main_language": "lzh",
          "columns": [
            {
              "text": "敷之去其蔽障則目自明"
            },
            {
              "text": "矣惟不可割至第五重蓋第"
            },
            {
              "text": "五重係最要之樞幸是處"
            },
            {
              "text": "尚無翳耳如法治之旬餘"
            },
            {
              "text": "目果復明於是該處瞽人"
            },
            {
              "text": "聞而求治者踵趾相接"
            },
            {
              "text": "不知西醫皆能療治"
            },
            {
              "text": "以補天地之缺憾"
            },
            {
              "text": "否耶"
            }
          ],
