  <text>
    <body>
      <div type="codex">
        <pb n="1" facs="#f01" />
        <div n="1" type="scan" subtype="complete-illustrated-report">
          <div type="page-face" n="right" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f01-r-c01">
              <seg type="diplomatic-text">今夫天下之扁盧妙手因病</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-r-c02">
              <seg type="diplomatic-text">施藥輒奏奇功而於目疾獨</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-r-c03">
              <seg type="diplomatic-text">少治法即市上偶有專醫眼</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-r-c04">
              <seg type="diplomatic-text">科者亦祗能治未瞽之目而</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-r-c05">
              <seg type="diplomatic-text">不能治已瞽之目也乃福州</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-r-c06">
              <seg type="diplomatic-text">時昇里塔亭街地方有濟世</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-r-c07">
              <seg type="diplomatic-text">醫館其中西醫二人皆有國</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-r-c08">
              <seg type="diplomatic-text">手之目凡疑難之症醫治獲</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-r-c09">
              <seg type="diplomatic-text">痊者姑勿賸論□奇者有鄉</seg>
            </ab>
            <ab type="column" n="10" xml:id="f01-r-c10">
              <seg type="diplomatic-text">人王玉山素業手藝雙目失</seg>
            </ab>
            <ab type="column" n="11" xml:id="f01-r-c11">
              <seg type="diplomatic-text">明業已九年一日至該館求</seg>
            </ab>
            <ab type="column" n="12" xml:id="f01-r-c12">
              <seg type="diplomatic-text">治適西醫亞丹先生為之診</seg>
            </ab>
            <ab type="column" n="13" xml:id="f01-r-c13">
              <seg type="diplomatic-text">視曰目珠似雉子一重又一</seg>
            </ab>
            <ab type="column" n="14" xml:id="f01-r-c14">
              <seg type="diplomatic-text">重共三十二重今子目有翳</seg>
            </ab>
            <ab type="column" n="15" xml:id="f01-r-c15">
              <seg type="diplomatic-text">在第四重宜用刀割之藥水</seg>
            </ab>
            <ab type="page-feature" subtype="article-title" facs="#f01-r-feature-1">
              <label>篇題</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">瞽目復明</seg>
            </ab>
            <ab type="page-feature" subtype="artist-signature" facs="#f01-r-feature-2">
              <label>圖內右下畫款</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">符節</seg>
            </ab>
            <ab type="page-feature" subtype="artist-seal" facs="#f01-r-feature-3">
              <label>畫款下方印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
          </div>
          <div type="page-face" n="left" xml:lang="lzh">
            <ab type="column" n="1" xml:id="f01-l-c01">
              <seg type="diplomatic-text">敷之去其蔽障則目自明</seg>
            </ab>
            <ab type="column" n="2" xml:id="f01-l-c02">
              <seg type="diplomatic-text">矣惟不可割至第五重蓋第</seg>
            </ab>
            <ab type="column" n="3" xml:id="f01-l-c03">
              <seg type="diplomatic-text">五重係最要之樞幸是處</seg>
            </ab>
            <ab type="column" n="4" xml:id="f01-l-c04">
              <seg type="diplomatic-text">尚無翳耳如法治之旬餘</seg>
            </ab>
            <ab type="column" n="5" xml:id="f01-l-c05">
              <seg type="diplomatic-text">目果復明於是該處瞽人</seg>
            </ab>
            <ab type="column" n="6" xml:id="f01-l-c06">
              <seg type="diplomatic-text">聞而求治者踵趾相接</seg>
            </ab>
            <ab type="column" n="7" xml:id="f01-l-c07">
              <seg type="diplomatic-text">不知西醫皆能療治</seg>
            </ab>
            <ab type="column" n="8" xml:id="f01-l-c08">
              <seg type="diplomatic-text">以補天地之缺憾</seg>
            </ab>
            <ab type="column" n="9" xml:id="f01-l-c09">
              <seg type="diplomatic-text">否耶</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f01-l-feature-1">
              <label>原刊圖號</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">五</seg>
            </ab>
            <ab type="page-feature" subtype="form-mark" facs="#f01-l-feature-2">
              <label>原刊期碼</label>
              <seg type="diplomatic-text" rend="unknown" xml:lang="lzh">匏一</seg>
            </ab>
            <ab type="page-feature" subtype="printer-seal" facs="#f01-l-feature-3">
              <label>圖說末方印</label>
              <seg type="diplomatic-text" rend="unknown" />
            </ab>
          </div>
          <div type="editorial-observations">
            <ab type="layout">右側三字直標並左列明字為篇題。正文右15欄、左9欄。左版記與右下款印分錄。</ab>
            <ab type="transcription-issue" n="right:9">
              <quote>勿賸論□奇者</quote>
              <seg type="candidate">賸</seg>
              <seg type="candidate">贅</seg>
              <seg type="candidate">噫</seg>
              <seg type="candidate">嗟</seg>
              <note type="editorial">論兩側有走筆，待核各字。</note>
            </ab>
            <ab type="transcription-issue" n="right:13">
              <quote>似雉子</quote>
              <seg type="candidate">雉</seg>
              <seg type="candidate">雞</seg>
              <note type="editorial">隹旁上有細筆，依初讀保留候選。</note>
            </ab>
          </div>
        </div>
      </div>
    </body>
